# Backend FastAPI Quantitative Engine URL
# In local development: http://localhost:8000
# In production on Vercel: Set this to your deployed backend URL (e.g., https://api-algolab.yourdomain.com or Railway/Render URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js Server Port (local development)
PORT=3000
